{
  "name": "@gander/app",
  "version": "0.1.11",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:e2e": "pnpm build && tsx e2e/run.ts",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:unsigned": "electron-vite build && electron-builder --mac --dir -c.mac.identity=null -c.mac.notarize=false"
  },
  "dependencies": {
    "@gander/shared": "workspace:*",
    "electron-updater": "^6.8.9",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.52.0",
    "vue": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gander/service": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "@wdio/cli": "9.29.1",
    "@wdio/electron-service": "10.2.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "electron": "^33.0.0",
    "electron-chromedriver": "33.4.11",
    "electron-vite": "^3.0.0",
    "fastify": "^5.12.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.10",
    "electron-builder": "^26.15.3"
  },
  "description": "Review code diffs, branches, and pull requests",
  "author": {
    "name": "Stephen Clarke",
    "email": "steve@sevenview.ca"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveclarke/gander.git",
    "directory": "packages/app"
  },
  "desktopName": "gander.desktop"
}
