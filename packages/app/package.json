{
  "name": "@gander/app",
  "version": "0.1.36",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:e2e": "pnpm run build && pnpm run test:e2e:run",
    "test:e2e:run": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:unsigned": "electron-vite build && electron-builder --mac --dir -c.mac.identity=null -c.mac.notarize=false"
  },
  "dependencies": {
    "@gander/shared": "workspace:*",
    "@lucide/vue": "^1.61.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.52.2",
    "vue": "^3.5.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gander/service": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.5.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "fastify": "^5.12.7",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.13"
  },
  "description": "Review code diffs, branches, and pull requests",
  "author": {
    "name": "Stephen Clarke",
    "email": "steve@sevenview.ca"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveclarke/gander.git",
    "directory": "packages/app"
  },
  "desktopName": "gander.desktop"
}
