#!/usr/bin/env bash
set -euo pipefail

################################################################################
# Gander MCP Development Client
################################################################################
#
# Runs the official MCP Inspector against the Gander service belonging to this
# checkout. The endpoint, bearer token, and Inspector ports come from the
# worktree-local .env generated by bin/setup.
#
################################################################################

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
ENV_FILE="$SCRIPT_ROOT/.env"
INSPECTOR_PACKAGE="${GANDER_MCP_INSPECTOR_PACKAGE:-}"
MCP_URL=""
AUTH_HEADER=""

################################################################################
# Main Orchestration
################################################################################

main() {
  local command="${1:-check}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    check) cmd_check "$@" ;;
    tools) cmd_tools "$@" ;;
    call) cmd_call "$@" ;;
    tui) cmd_tui "$@" ;;
    inspect|web) cmd_inspect "$@" ;;
    help|-h|--help) usage ;;
    *) fail "Unknown command: $command" ;;
  esac
}

################################################################################
# Output and Help
################################################################################

usage() {
  cat <<'USAGE'
bin/mcp — Test and inspect this worktree's Gander MCP endpoint.

Commands:
  check                         Verify health, authentication, and core tools
  tools                         List the endpoint's MCP tools
  call TOOL [key=value ...]     Call a tool with Inspector-style arguments
  call TOOL --json JSON         Call a tool with one JSON arguments object
  tui                           Open MCP Inspector's terminal interface
  inspect, web                  Open MCP Inspector's web interface

Examples:
  bin/mcp check
  bin/mcp tools
  bin/mcp call get_review_notes repo=steveclarke/gander branch=master
  bin/mcp call get_review_notes --json '{"repo":"steveclarke/gander","prNumber":4}'
  bin/mcp tui
  bin/mcp inspect

Run bin/setup once and start the service with bin/dev or bin/dev -D first.
USAGE
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

################################################################################
# Configuration and Transport
################################################################################

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required."
}

load_config() {
  [[ -f "$ENV_FILE" ]] || fail "$ENV_FILE is missing. Run bin/setup first."

  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a

  [[ -n "${GANDER_SERVICE_URL:-}" ]] || fail "GANDER_SERVICE_URL is missing from $ENV_FILE. Run bin/setup."
  [[ -n "${GANDER_TOKEN:-}" ]] || fail "GANDER_TOKEN is missing from $ENV_FILE. Run bin/setup."

  MCP_URL="${GANDER_SERVICE_URL%/}/mcp"
  AUTH_HEADER="Authorization: Bearer $GANDER_TOKEN"
}

ensure_service() {
  require_command curl
  if ! curl --silent --show-error --fail --max-time 3 "${GANDER_SERVICE_URL%/}/healthz" >/dev/null; then
    fail "Gander service is not ready at $GANDER_SERVICE_URL. Start it with bin/dev -D."
  fi
}

run_inspector() {
  require_command pnpm
  if [[ -n "$INSPECTOR_PACKAGE" ]]; then
    (cd "$SCRIPT_ROOT" && pnpm dlx "$INSPECTOR_PACKAGE" "$@")
  else
    (cd "$SCRIPT_ROOT" && pnpm exec mcp-inspector "$@")
  fi
}

run_cli() {
  run_inspector --cli \
    --server-url "$MCP_URL" \
    --transport http \
    --header "$AUTH_HEADER" \
    "$@"
}

prepare_client() {
  load_config
  ensure_service
}

################################################################################
# Commands
################################################################################

cmd_check() {
  [[ $# -eq 0 ]] || fail "check does not accept arguments."
  prepare_client
  require_command node

  local response
  if ! response="$(run_cli --method tools/list --format json)"; then
    fail "MCP Inspector could not list tools from $MCP_URL."
  fi

  local tool_names
  if ! tool_names="$(printf '%s' "$response" | node -e '
    const fs = require("node:fs");
    const payload = JSON.parse(fs.readFileSync(0, "utf8"));
    const names = (payload.result?.tools ?? []).map((tool) => tool.name).sort();
    const required = ["get_review_notes", "mark_note_addressed"];
    const missing = required.filter((name) => !names.includes(name));
    if (missing.length > 0) {
      console.error("Missing core MCP tools: " + missing.join(", "));
      process.exit(1);
    }
    process.stdout.write(names.join(", "));
  ')"; then
    fail "MCP endpoint responded, but its tool contract is invalid."
  fi

  printf 'MCP OK\nEndpoint: %s\nTools: %s\n' "$MCP_URL" "$tool_names"
}

cmd_tools() {
  [[ $# -eq 0 ]] || fail "tools does not accept arguments."
  prepare_client
  run_cli --method tools/list
}

cmd_call() {
  local tool="${1:-}"
  [[ -n "$tool" ]] || fail "Specify a tool. See bin/mcp help."
  shift
  prepare_client

  local -a args=(--method tools/call --tool-name "$tool")
  if [[ "${1:-}" == "--json" ]]; then
    [[ $# -eq 2 ]] || fail "Use: bin/mcp call TOOL --json JSON"
    args+=(--tool-args-json "$2")
  else
    local pair
    for pair in "$@"; do
      [[ "$pair" == *=* ]] || fail "Tool arguments must use key=value: $pair"
      args+=(--tool-arg "$pair")
    done
  fi

  run_cli "${args[@]}"
}

cmd_tui() {
  [[ $# -eq 0 ]] || fail "tui does not accept arguments."
  prepare_client
  run_inspector --tui \
    --server-url "$MCP_URL" \
    --transport http \
    --header "$AUTH_HEADER"
}

cmd_inspect() {
  [[ $# -eq 0 ]] || fail "inspect does not accept arguments."
  prepare_client

  [[ -n "${MCP_INSPECTOR_CLIENT_PORT:-}" ]] || fail "Inspector ports are missing from $ENV_FILE. Run bin/setup."
  [[ -n "${MCP_INSPECTOR_SANDBOX_PORT:-}" ]] || fail "Inspector ports are missing from $ENV_FILE. Run bin/setup."

  (
    export HOST=127.0.0.1
    export CLIENT_PORT="$MCP_INSPECTOR_CLIENT_PORT"
    export MCP_SANDBOX_PORT="$MCP_INSPECTOR_SANDBOX_PORT"
    run_inspector --web \
      --server-url "$MCP_URL" \
      --transport http \
      --header "$AUTH_HEADER"
  )
}

################################################################################
# Script Execution
################################################################################

main "$@"
